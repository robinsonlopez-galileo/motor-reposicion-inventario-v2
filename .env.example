# Archivo opcional: docker compose funciona sin .env con estos mismos valores por defecto.
# Para cambiarlos: cp .env.example .env y edite.

# Usuario y clave de la interfaz de Airflow (http://localhost:8080)
AIRFLOW_USUARIO=airflow
AIRFLOW_CLAVE=airflow

# En Linux, use su UID para que los archivos creados tengan su usuario: echo "AIRFLOW_UID=$(id -u)"
AIRFLOW_UID=50000

# Periodo de operación (vacío = config/operacion.yaml: corte 2016-12-31, fin 2017-08-15)
CORTE_HISTORICO=
FIN_OPERACION=

# Tareas de Airflow en paralelo y segundos entre revisiones de los sensores
AIRFLOW_PARALELISMO=6
MOTOR_POKE_INTERVAL=60

# Claves internas (cámbielas si expone Airflow fuera de su máquina)
POSTGRES_CLAVE=airflow
AIRFLOW_JWT_SECRET=motor-reposicion-clave-jwt-local
